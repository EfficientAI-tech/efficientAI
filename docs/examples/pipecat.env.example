# Copy to your Pipecat project as .env (ONE TIME per deployment)
#
#   cp docs/examples/pipecat.env.example ~/Downloads/work/pipecat-examples/websocket/.env
#   # fill in EFFICIENTAI_API_KEY + EFFICIENTAI_WORKSPACE_ID, then restart bot.py
#
# Per call: call_short_id is minted automatically — do NOT set it manually.

# EfficientAI observability — set once in prod (K8s secret / Pipecat Cloud env / .env)
EFFICIENTAI_API_KEY=
EFFICIENTAI_WORKSPACE_ID=

# Multi-agent example (pipecat_multi_agent_webrtc_tracing.py)
FIREWORKS_API_KEY=
ELEVENLABS_API_KEY=
# PIPECAT_STT_PROVIDER=elevenlabs
# DEEPGRAM_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# FIREWORKS_MODEL=accounts/fireworks/models/llama-v3p1-8b-instruct

# Multi-provider example (pipecat_multi_provider_webrtc_tracing.py)
# DEEPGRAM_API_KEY=
# OPENAI_API_KEY=
# CARTESIA_API_KEY=

# Gemini Live example (pipecat_upstream_webrtc_tracing.py)
GOOGLE_API_KEY=

# Optional overrides (defaults work for local eai start-all)
# EFFICIENTAI_API_BASE=http://localhost:8000
# EFFICIENTAI_API_BASE=https://staging.efficientai.cloud
# EFFICIENTAI_OTLP_ENDPOINT=https://staging.efficientai.cloud/api/v1/observability/traces
