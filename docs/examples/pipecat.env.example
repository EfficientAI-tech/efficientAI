# Copy to your Pipecat project as .env (one folder per bot deployment)
#
#   curl -fsSL "https://raw.githubusercontent.com/EfficientAI-tech/efficientAI/otel-traces/docs/examples/pipecat.env.example" -o .env
#   # or: cp docs/examples/pipecat.env.example /path/to/your-pipecat-project/.env
#
# Pre-filled block: GET /api/v1/observability/traces/setup (X-API-Key + X-Workspace-Id)
# Docs: https://docs.efficientai.cloud/docs/monitoring/call-traces/pipecat-integration/
#
# Per call: Call ID is assigned automatically — do NOT set EFFICIENTAI_CALL_SHORT_ID.

# =============================================================================
# Sandbox (hosted) — default for teammates, demos, and integration testing
# You do NOT run EfficientAI on your laptop for this path.
# =============================================================================
EFFICIENTAI_API_BASE=https://sandbox.efficientai.cloud
EFFICIENTAI_OTLP_ENDPOINT=https://sandbox.efficientai.cloud/api/v1/observability/traces
EFFICIENTAI_WORKSPACE_ID=
EFFICIENTAI_API_KEY=

# =============================================================================
# Local EfficientAI — only if YOU run the API on this machine (eai start-all)
# Use a different workspace ID than sandbox so traces never mix.
# Comment out the sandbox block above and uncomment below.
# =============================================================================
# EFFICIENTAI_API_BASE=http://localhost:8000
# EFFICIENTAI_OTLP_ENDPOINT=http://localhost:8000/api/v1/observability/traces
# EFFICIENTAI_WORKSPACE_ID=
# EFFICIENTAI_API_KEY=

# Your Pipecat provider keys (examples)
# DEEPGRAM_API_KEY=
# OPENAI_API_KEY=
# CARTESIA_API_KEY=
# FIREWORKS_API_KEY=
# ELEVENLABS_API_KEY=
# GOOGLE_API_KEY=
