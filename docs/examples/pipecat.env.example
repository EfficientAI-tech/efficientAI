# Copy to your Pipecat project as .env (one time per deployment)
#
#   cp docs/examples/pipecat.env.example /path/to/your-pipecat-project/.env
#   # fill in EFFICIENTAI_API_KEY, then restart your bot
#
# Easier: open EfficientAI → Observability → Calls → Connect Pipecat
# and copy the pre-filled .env block for your workspace.
#
# Per call: Call ID is assigned automatically — do NOT set it in .env.

# Required — point at EfficientAI (staging example below)
EFFICIENTAI_API_BASE=https://staging.efficientai.cloud
EFFICIENTAI_WORKSPACE_ID=
EFFICIENTAI_API_KEY=

# Local EfficientAI (optional)
# EFFICIENTAI_API_BASE=http://localhost:8000

# Advanced — usually derived from EFFICIENTAI_API_BASE
# EFFICIENTAI_OTLP_ENDPOINT=https://staging.efficientai.cloud/api/v1/observability/traces

# Your Pipecat provider keys (examples)
# DEEPGRAM_API_KEY=
# OPENAI_API_KEY=
# CARTESIA_API_KEY=
# FIREWORKS_API_KEY=
# ELEVENLABS_API_KEY=
# GOOGLE_API_KEY=
