      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "3QyJb0oIQT",
      "originalText": "Routing formula:\n  slice_id = row_index // 500\n  shard_id = SHA256(call_import_id : slice_id) mod 4",
      "lineHeight": 1.35
    },
